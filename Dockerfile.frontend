# Frontend Dockerfile for development
FROM node:20-alpine

# Install system dependencies for Node.js compatibility
RUN apk add --no-cache \
    python3 \
    make \
    g++ \
    libc6-compat

# Set working directory
WORKDIR /app

# Copy package files
COPY frontend-client/package*.json ./

# Install dependencies
RUN npm install

# Copy source code
COPY frontend-client/ ./

# Expose port
EXPOSE 3011

# Start the development server without auto-opening browser
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--no-open"]
